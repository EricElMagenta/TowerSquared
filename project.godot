[internationalization]

locale/translation_remaps={
"res://assets/UI/controls-kbd-mouse_en.png": PackedStringArray("res://assets/UI/controls-kbd-mouse_en.png:en", "res://assets/UI/control-kbd-mouse_es.png:es"),
"res://assets/UI/controls-kbd_en.png": PackedStringArray("res://assets/UI/controls-kbd_en.png:en", "res://assets/UI/control-kbd_es.png:es")
}
locale/translations=PackedStringArray("res://sample.es.translation", "res://sample.en.translation")
locale/fallback=""
locale/locale_filter_mode=0

[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="Enemies"
2d_physics/layer_4="PowerUps"
2d_physics/layer_5="Projectiles"
2d_physics/layer_6="Objects"
2d_physics/layer_7="EnemyProjectiles"
2d_physics/layer_8="Hazards"
2d_physics/layer_9="Npc"
2d_physics/layer_10="Bubbles"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
